<mujoco model="neoracer">
    <!--
    NeoRacer 1/8-scale RC car. Single source of truth for the model.

    Coordinate frame: +X = forward, +Y = left, +Z = up. Lengths in meters,
    angles in radians, masses in kg.

    Each wheel body carries up to three joints, declared innermost → outermost:
    suspension (slide Z), steer (hinge Z, front only), drive (hinge Y). All
    joints for a wheel must stay on the SAME body — if suspension is split onto
    a separate intermediate body, MuJoCo's equality solver cannot propagate
    forces through the chain and the Ackermann constraints break silently.

    Masses are set explicitly on geoms; the meshes are cosmetic (mass="0").
    -->

    <compiler angle="radian" autolimits="true"/>

    <!-- Elliptic friction cone + high impratio: MuJoCo's recommended setting for
         wheeled vehicles — stiffens tangential contact so the tires creep less
         sideways (measured at 0.4 rad of steering: full-lock radius 0.77 m → 0.74 m vs 0.68 m ideal).
         The time step is 1/360 s: 12 steps to a 30 Hz LiDAR scan and 6 to a
         60 Hz frame. implicitfast integrates the actuators' speed damping (the
         motors' back-EMF and the servo's kd), which explicit Euler cannot hold
         steady at this step: the servo then chatters.
         When this car is attached to a track scene, MuJoCo keeps the track's
         <option>, so every track in tracks/ sets the same values. -->
    <option timestep="0.002777777777777778" integrator="implicitfast" cone="elliptic" impratio="10"/>

    <asset>
        <texture name="grid" type="2d" builtin="checker" width="512" height="512"
                 rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
        <material name="grid" texture="grid" texrepeat="1 1" texuniform="true"
                  reflectance=".2"/>

        <!-- Cosmetic meshes (meters, x=fwd y=left z=up), from the older osracer CAD
             model. The wheel meshes are centred on their wheel body origin and scaled
             from its 50 mm wheels to the 42.5 mm tyres. None of these affect physics. -->
        <mesh name="vis_chassis"  file="meshes/chassis.STL"/>
        <mesh name="vis_fl_wheel" file="meshes/fl_wheel.STL" scale=".85 .85 .85"/>
        <mesh name="vis_fr_wheel" file="meshes/fr_wheel.STL" scale=".85 .85 .85"/>
        <mesh name="vis_rl_wheel" file="meshes/rl_wheel.STL" scale=".85 .85 .85"/>
        <mesh name="vis_rr_wheel" file="meshes/rr_wheel.STL" scale=".85 .85 .85"/>
        <mesh name="vis_lidar"    file="meshes/lidar.STL"/>
    </asset>

    <default>
        <!-- Default joint damping and actuator force range for all joints. -->
        <joint damping=".03" actuatorfrcrange="-3 3"/>

        <!--
        Wheel drive joint: hinge about the Y-axis (the axle). Its inertia is the
        wheel's own, from the geom: a cylinder of the wheel's mass.
        geom: cylinder, radius 42.5 mm (the 85 mm tyre of the spec) and half the
        measured tyre width of 48.25 mm. condim=3 (sliding only); condim=6 adds
        torsional/rolling contact that chatters on small cylinders.
        mass is set per wheel instance, not here.
        priority=1: in a contact with the floor or a wall, MuJoCo takes the
        friction and the contact softness of the wheel alone, instead of the
        larger friction of the two geoms. The wheel geom then sets its own grip,
        so changing its friction changes how much the wheel slips.
        -->
        <default class="wheel">
            <joint type="hinge" axis="0 1 0" damping=".0005"/>
            <geom type="cylinder" size=".0425 .024125" zaxis="0 1 0"
                  friction="1.5 .1 .1" condim="3" priority="1"/>
        </default>

        <!--
        Steering joint: hinge about the Z-axis (vertical). Its range is wider
        than the inner front wheel's angle at the edge of steer_input's range
        (neoracer_spec.derive.wheel_steer_range), so it never opposes the Ackermann
        constraints.
        -->
        <default class="steer">
            <joint type="hinge" axis="0 0 1" limited="true" range="-.551706 .551706"
                   damping=".001" armature=".0002" frictionloss=".01"
                   actuatorfrcrange="-100 100"/>
        </default>

        <!--
        Suspension joint: prismatic (slide) along Z. Declared FIRST on each wheel
        body so the equality solver can couple the steer joint correctly.
        Travel: -.010 m droop to +.015 m jounce. stiffness/damping give a slightly
        overdamped response; replace them with the real coil-over spec when measured.
        springref preloads each spring with a quarter of the sprung weight
        (neoracer_spec.derive.spring_ref), so the car rests at the ride height of the CAD
        model, with the joints near 0.
        -->
        <default class="susp">
            <joint type="slide" axis="0 0 1" range="-.01 .015"
                   stiffness="600" springref="-.0113028" damping="25"/>
        </default>
    </default>

    <worldbody>
        <!-- Ground plane; friction matches the wheels. -->
        <geom type="plane" size="5 5 .01" material="grid" friction="1.5 .1 .1"/>

        <!--
        Car body. The geometry is the production car's, measured from its CAD
        model (the playground's neoracer-race.glb, 2026). The body frame is at
        the middle of the wheelbase, on the axle line. The car spawns 1 mm
        above its resting height, the axles at the tyre radius. The wheelbase,
        the track and the radius are the car's (neoracer_spec.neoracer).
        -->
        <body name="car" pos="0 0 .0435">
            <freejoint/>
            <light name="top_light" pos="0 0 2" mode="trackcom" diffuse=".4 .4 .4"/>

            <!--
            The chassis' mass is the car's less the four wheels and the steering
            input body, and its inertia the CAD-derived URDF's scaled to that
            mass (neoracer_spec.derive.chassis_mass, chassis_inertia); nobody has
            measured it. The CoM is above the middle of the wheelbase, at the
            URDF's height above the axles. This explicit <inertial> overrides
            geom-derived inertia, so the box's mass is ignored.
            -->
            <inertial pos="0 0 .0189" mass="2.7552"
                      diaginertia=".00403992 .00992457 .0119068"/>

            <!-- Chassis collision box: the measured body, 481×241×184 mm, from the
                 bottom of the chassis tub (19.5 mm above the ground at rest) to the
                 top of the LiDAR. Collision only; mass set via <inertial> above. -->
            <geom name="chassis" type="box" pos=".016865 -.00287 .069"
                  size=".240635 .12042 .09198" rgba=".3 .6 .3 0.1" mass="0"/>
            <!-- Cosmetic chassis mesh (contype/conaffinity=0 → no physics). It is the
                 older osracer CAD model, not the production car, so it only roughly
                 fills the box; it keeps its old place relative to the wheels. -->
            <geom name="vis_chassis" type="mesh" mass="0" mesh="vis_chassis"
                  pos="0.033 0 0.1026"
                  contype="0" conaffinity="0"
                  rgba=".75 .75 .75 1"/>

            <!-- IMU site at the centre of mass; sensors below reference it. -->
            <site name="imu" pos="0 0 .0189" size=".01" rgba="1 1 0 1"/>

            <!-- LiDAR mount site: the centre of the LiDAR, as measured. -->
            <site name="lidar_mount" pos="-.0442 0 .11995" size=".02" rgba="1 0 0 .5"/>

            <!--
            LiDAR ray sites: 8 beams at 45° intervals in the horizontal plane.
            zaxis="cosθ sinθ 0" points the site's local Z (the rangefinder's
            sensing direction) directly at heading θ from +X (forward), θ
            measured toward +Y (left). NOTE: this used to be written as
            euler="0 90 θ", which looked plausible but was wrong for ANY value
            of θ — MuJoCo composes intrinsic-xyz euler as R = Rx·Ry·Rz applied
            to the vector, so Rz(θ) is the first rotation applied to the site's
            local Z axis (0,0,1) and rotating a vector about the axis it
            already lies on is a no-op; θ could never actually steer the beam.
            All 8 beams pointed the same direction as a result. zaxis sidesteps
            euler composition order entirely and was verified beam-by-beam
            (single-wall placement test) to produce a correctly directional ring.
            Add more beams here (and matching rangefinders below) for richer RL obs.
            -->
            <site name="lidar_000" pos="-.0442 0 .11995" zaxis="1.000000  0.000000 0" size=".005"/>
            <site name="lidar_045" pos="-.0442 0 .11995" zaxis="0.707107  0.707107 0" size=".005"/>
            <site name="lidar_090" pos="-.0442 0 .11995" zaxis="0.000000  1.000000 0" size=".005"/>
            <site name="lidar_135" pos="-.0442 0 .11995" zaxis="-0.707107 0.707107 0" size=".005"/>
            <site name="lidar_180" pos="-.0442 0 .11995" zaxis="-1.000000 0.000000 0" size=".005"/>
            <site name="lidar_225" pos="-.0442 0 .11995" zaxis="-0.707107 -0.707107 0" size=".005"/>
            <site name="lidar_270" pos="-.0442 0 .11995" zaxis="0.000000  -1.000000 0" size=".005"/>
            <site name="lidar_315" pos="-.0442 0 .11995" zaxis="0.707107  -0.707107 0" size=".005"/>
            <!-- Cosmetic lidar mesh at the mount site. -->
            <geom name="vis_lidar" type="mesh" mass="0" mesh="vis_lidar"
                  pos="-.0442 0 .11995"
                  contype="0" conaffinity="0" rgba=".2 .2 .2 1"/>

            <!--
            Virtual steering input — not a physical part. The steering servo drives
            this joint; the two Ackermann equality constraints below split the
            command into fl_steer and fr_steer with the correct inner/outer differential.
            -->
            <body name="steer_input_body" pos=".14382 0 0">
                <joint name="steer_input" class="steer" range="-.45 .45"/>
                <geom type="cylinder" size=".02 .005" contype="0" conaffinity="0"
                      mass=".01" rgba="1 0 0 .3"/>
            </body>

            <!--
            FRONT LEFT WHEEL — steerable + driven.

            Joint order on this body (innermost → outermost):
              1. fl_susp  (slide Z)  : suspension travel (spring + damper)
              2. fl_steer (hinge Z)  : steering angle, set by Ackermann constraint
              3. fl_drive (hinge Y)  : wheel spin, driven by motor actuator
            All three must stay on the SAME body (see <default class="susp">).

            Position: x=0.14382 (half wheelbase), y=0.112 (half track), z=0 (the
            axle line). Wheel masses from URDF (~0.058 kg each); inertia is left to
            MuJoCo's cylinder geom.
            -->
            <body name="fl_wheel_body" pos=".14382 .112 0">
                <joint name="fl_susp"  class="susp"/>
                <joint name="fl_steer" class="steer"/>
                <joint name="fl_drive" class="wheel"/>
                <geom name="fl_wheel" class="wheel" mass=".0587" rgba=".2 .4 1 0.1"/>
                <geom name="vis_fl_wheel" type="mesh" mass="0" mesh="vis_fl_wheel"
                      contype="0" conaffinity="0" rgba=".15 .15 .15 1"/>
            </body>

            <!-- FRONT RIGHT WHEEL — steerable + driven -->
            <body name="fr_wheel_body" pos=".14382 -.112 0">
                <joint name="fr_susp"  class="susp"/>
                <joint name="fr_steer" class="steer"/>
                <joint name="fr_drive" class="wheel"/>
                <geom name="fr_wheel" class="wheel" mass=".0587" rgba=".2 .4 1 0.1"/>
                <geom name="vis_fr_wheel" type="mesh" mass="0" mesh="vis_fr_wheel"
                      contype="0" conaffinity="0" rgba=".15 .15 .15 1"/>
            </body>

            <!-- REAR LEFT WHEEL — driven only (no steer joint) -->
            <body name="rl_wheel_body" pos="-.14382 .112 0">
                <joint name="rl_susp"  class="susp"/>
                <joint name="rl_drive" class="wheel"/>
                <geom name="rl_wheel" class="wheel" mass=".0587" rgba=".3 .3 .3 0.1"/>
                <geom name="vis_rl_wheel" type="mesh" mass="0" mesh="vis_rl_wheel"
                      contype="0" conaffinity="0" rgba=".15 .15 .15 1"/>
            </body>

            <!-- REAR RIGHT WHEEL — driven only -->
            <body name="rr_wheel_body" pos="-.14382 -.112 0">
                <joint name="rr_susp"  class="susp"/>
                <joint name="rr_drive" class="wheel"/>
                <geom name="rr_wheel" class="wheel" mass=".0587" rgba=".3 .3 .3 0.1"/>
                <geom name="vis_rr_wheel" type="mesh" mass="0" mesh="vis_rr_wheel"
                      contype="0" conaffinity="0" rgba=".15 .15 .15 1"/>
            </body>

        </body>
    </worldbody>

    <!--
    Drivetrain: one motor turns all four wheels through open differentials.
    An open differential gives each wheel the same torque and turns the motor
    at the mean speed of the wheels. The fixed tendon below does both: its
    velocity is the mean wheel speed (rad/s), and a force f on it puts f/4 on
    each wheel. Drivetrain losses are not modelled.
    -->
    <tendon>
        <fixed name="drivetrain">
            <joint joint="fl_drive" coef=".25"/>
            <joint joint="fr_drive" coef=".25"/>
            <joint joint="rl_drive" coef=".25"/>
            <joint joint="rr_drive" coef=".25"/>
        </fixed>
    </tendon>

    <actuator>
        <!--
        The motor, as MuJoCo's DC motor model. ctrl is the voltage at its
        terminals (V), + = forward: the speed controller (ESC) applies the
        battery voltage times the throttle. Its torque is K (V - K w) / R for
        a speed w, so it is largest from rest, falls to 0 at the free speed
        V / K, and a voltage of 0 brakes. MuJoCo derives K and R from
        nominal = "voltage stall_torque free_speed".

        The motor is the car's RS-545. nominal is its rated voltage, stall
        torque and free speed, gear its reduction to the wheels and ctrlrange
        the battery's voltage, all from neoracer_spec.neoracer (motor, battery). The
        rotor's inertia is not known, so the model leaves it out.
        -->
        <dcmotor name="motor" tendon="drivetrain" nominal="12 .0937957 1151.92"
                 gear="10.55" ctrlrange="-11.1 11.1"/>

        <!--
        The steering servo, as a DC motor with its own position loop: ctrl is
        the target angle of steer_input (rad), + = left, and the Ackermann
        constraints below turn the two front wheels from it. The loop's
        voltage is kp (target - angle) - kd x speed, clamped to the servo's
        5 V supply. The motor's torque falls as it speeds up, so it turns the
        wheels at most at its free speed, as a real servo does.

        The servo is the car's SPT5435LV-180W. nominal is its supply, stall
        torque and free speed at steer_input, through the linkage from its
        horn, controller its loop's kp, ki, kd and voltage clamp, and
        ctrlrange full lock, where the inner front wheel reaches the angle
        measured on the car: all from neoracer_spec.neoracer (servo, steering).
        -->
        <dcmotor name="steer_servo" joint="steer_input" input="pos"
                 nominal="5 3.2785 5.99818" controller="50 0 1 0 0 5"
                 ctrlrange="-.440491 .440491"/>
    </actuator>

    <!--
    Ackermann steering: each front wheel coupled to steer_input by a 4th-order polynomial.

        fl_steer = arctan(L / (L/tan(δ) − W/2))   (inner wheel, turns more)
        fr_steer = arctan(L / (L/tan(δ) + W/2))   (outer wheel, turns less)

    L is the wheelbase and W the track. The coefficients are a least-squares
    fit to these over the range of steer_input (neoracer_spec.derive.ackermann_left).

    polycoef: a0 a1 a2 a3 a4  →  y = a0 + a1·x + a2·x² + a3·x³ + a4·x⁴

    solref "0.006 1" makes the linkage stiffer than MuJoCo's default (0.02 s):
    under the tyres' load the wheels then lag their Ackermann angles by 0.004
    rad, not 0.04. The time constant stays above two time steps at 360 Hz.
    -->
    <equality>
        <joint name="ackermann_left" solref=".006 1"
               joint1="fl_steer" joint2="steer_input"
               polycoef="-1.36675e-05 1.00127 .390823 .12243 -.0931586"/>
        <joint name="ackermann_right" solref=".006 1"
               joint1="fr_steer" joint2="steer_input"
               polycoef="1.36675e-05 1.00127 -.390823 .12243 .0931586"/>
    </equality>

    <sensor>
        <!--
        IMU at the chassis centre: accelerometer (m/s²), gyro (rad/s), orientation
        quaternion, and world-frame linear velocity.
        -->
        <accelerometer name="imu_accel"  site="imu"/>
        <gyro          name="imu_gyro"   site="imu"/>
        <framequat     name="imu_quat"   objtype="site" objname="imu"/>
        <framelinvel   name="imu_linvel" objtype="site" objname="imu"/>

        <!--
        Steering angle sensors (radians).
        steer_cmd_pos = virtual command angle (input to Ackermann constraints).
        fl/fr_steer_pos = actual front wheel angles (inner > outer when turning).
        -->
        <jointpos name="steer_cmd_pos" joint="steer_input"/>
        <jointpos name="fl_steer_pos"  joint="fl_steer"/>
        <jointpos name="fr_steer_pos"  joint="fr_steer"/>

        <!--
        Wheel angular velocity (rad/s). Multiply by 0.0425 m (wheel_radius) for surface speed in m/s.
        Positive = forward rotation.
        -->
        <jointvel name="fl_wheel_vel" joint="fl_drive"/>
        <jointvel name="fr_wheel_vel" joint="fr_drive"/>
        <jointvel name="rl_wheel_vel" joint="rl_drive"/>
        <jointvel name="rr_wheel_vel" joint="rr_drive"/>

        <!--
        The drivetrain's angle (rad): the mean of the four wheels' angles,
        which the motor turns with through the open differentials. The motor
        encoder counts it; encoder.py turns it into the speed the car's
        firmware reports.
        -->
        <tendonpos name="drive_pos" tendon="drivetrain"/>

        <!--
        Suspension travel (meters).
        Positive = jounce (spring compressed, wheel moved up relative to car body).
        Negative = droop (spring extended).
        Near 0 at rest: springref preloads the springs.
        -->
        <jointpos name="fl_susp_pos" joint="fl_susp"/>
        <jointpos name="fr_susp_pos" joint="fr_susp"/>
        <jointpos name="rl_susp_pos" joint="rl_susp"/>
        <jointpos name="rr_susp_pos" joint="rr_susp"/>

        <!--
        LiDAR: 8 rangefinder beams at 45° intervals, one per ray site above.
        Each returns distance to the nearest geom (m), or -1 if nothing within cutoff.
        -->
        <rangefinder name="lidar_000" site="lidar_000"/>
        <rangefinder name="lidar_045" site="lidar_045"/>
        <rangefinder name="lidar_090" site="lidar_090"/>
        <rangefinder name="lidar_135" site="lidar_135"/>
        <rangefinder name="lidar_180" site="lidar_180"/>
        <rangefinder name="lidar_225" site="lidar_225"/>
        <rangefinder name="lidar_270" site="lidar_270"/>
        <rangefinder name="lidar_315" site="lidar_315"/>
    </sensor>

</mujoco>
