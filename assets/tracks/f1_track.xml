<mujoco model="f1_track">
    <!--
    Monaco-ish street circuit (feel-test, not for RL yet). Scenery ONLY:
    this file does not name the car. The driver composes it with
    neoracer.xml at runtime (MjSpec.attach), same as ramp_course.xml, so
    the floor comes from the car model and the scene stays car-agnostic.

    Closed loop, clockwise. The car spawns at the origin facing +X
    on the start/finish straight (y=0) and drives into Turn 1. Signature
    bits: long straight, a tight hairpin on the right, a left-right chicane
    up top, sweepers linking them. Inner + outer walls are thin static
    boxes 0.30 m tall (taller than the car, so it cannot hop them).

    Track width 0.70 m. Footprint ~10 x 8 m.

    GENERATED from a coarse centerline (Chaikin-smoothed, 2 iters). To
    reshape, edit the waypoints and regenerate. Coarse centerline (x,y):
    (-2.0,0.0), (5.5,0.0), (7.2,0.9), (7.6,2.2), (6.4,2.9), (6.6,3.9), (7.8,4.2), (7.3,5.6), (5.8,6.4), (3.6,6.2), (2.8,6.9), (1.6,6.2), (0.0,6.3), (-1.8,5.6), (-2.8,3.8), (-2.6,1.6), (-2.0,0.0)
    -->

    <asset>
        <material name="wall_outer" rgba=".80 .20 .20 1"/>
        <material name="wall_inner" rgba=".92 .92 .95 1"/>
    </asset>

    <default>
        <!-- All scenery is static; condim 3 = plain sliding contact. -->
        <default class="scenery">
            <geom type="box" condim="3" friction="1.0 0.1 0.1"/>
        </default>
    </default>

